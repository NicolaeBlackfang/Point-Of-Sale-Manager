# ====================================================================
# DEPENDENCIES (Never upload these, they make uploads freeze/fail)
# ====================================================================
node_modules/
server/node_modules/
apps/web/node_modules/

# Lockfiles are intentionally committed for reproducible installs (npm ci in CI).

# ====================================================================
# ENVIRONMENT VARIABLES (Contains your real Atlas passwords & secrets)
# ====================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
apps/web/.env
# Any other environment variant (server/.env.staging, apps/web/.env.prod, ...)
.env.*
# ...but never the templates — those are meant to be committed.
!*.env.example
!server/.env.example
!apps/web/.env.example

# Certificates, keys and other secret material
*.pem
*.key
*.p12
*.pfx
*.crt
*.keystore

# ====================================================================
# PRODUCTION BUILDS & LOGS
# ====================================================================
apps/web/dist/
apps/web/build/
dist/
build-output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/
.eslintcache
coverage/
.nyc_output/
*.tsbuildinfo

# ====================================================================
# OS CLUTTER (Ubuntu / Windows / Mac background junk)
# ====================================================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
.cache/

# ====================================================================
# EDITOR / IDE
# ====================================================================
.vscode/
.idea/
*.swp
*.swo

# ====================================================================
# PRODUCT IMAGE UPLOADS (runtime assets, regenerated on demand)
# ====================================================================
server/uploads/

# ====================================================================
# ELECTRON DESKTOP BUILD OUTPUT
# ====================================================================
dist-electron/
