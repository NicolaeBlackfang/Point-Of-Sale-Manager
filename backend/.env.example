# ---------------------------------------------------------------------------
# OpenPOS backend environment (copy to `.env` and fill in real values)
#   cp backend/.env.example backend/.env
# ---------------------------------------------------------------------------

# MongoDB connection string (local instance or Atlas). REQUIRED.
MONGODB_URI=mongodb://127.0.0.1:27017/openpos

# Secret used to sign JSON Web Tokens. REQUIRED — use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# HTTP port the API listens on.
PORT=5000

# Comma-separated list of allowed CORS origins (the frontend dev server).
CLIENT_URL=http://localhost:5173

# JWT lifetime (any value accepted by jsonwebtoken, e.g. 1d, 12h). Default: 1d
JWT_EXPIRE=1d

# Optional: POST low-stock alerts to this webhook. Can also be set at runtime in
# Store Settings (which takes precedence).
LOW_STOCK_WEBHOOK_URL=

# Content-Security-Policy is enabled by default with hardened directives.
# Set to `false` only if a reverse proxy manages CSP for you.
CSP_ENABLED=true

# Optional: initial Superadmin created by `npm run seed` (scripts/seed.js).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Administrator
